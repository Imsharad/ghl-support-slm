{
  "version": 1,
  "notes": "Applied in order by data/prepare.py. Reject rules fire on the original text. Placeholder replacement runs next; any leftover {{ }} rejects the row. Timeline numbers are allowed only when the instruction already contains them.",
  "rules": [
    {
      "id": "reject_completed_action",
      "action": "reject",
      "field": "response",
      "regex": "\\b((I|we)\\s+(have|already|'ve)\\s+(just\\s+)?(refunded|cancelled|canceled|unlocked|processed|issued|completed|deleted|updated|changed)|your\\s+(account|order|refund|request)\\s+is\\s+now\\s+(unlocked|cancelled|canceled|refunded|closed|active)|I\\s+have\\s+refunded|your\\s+account\\s+is\\s+now\\s+unlocked)\\b",
      "flags": "i"
    },
    {
      "id": "reject_invented_timeline",
      "action": "reject",
      "field": "response",
      "unless_in_instruction": true,
      "regex": "\\b(within\\s+\\d+\\s*(hours?|days?|business\\s+days?)|(?:\\d+\\s*[-–to]+\\s*)+\\d+\\s*(business\\s+)?(days?|hours?)|\\b(?:24|48)\\s*hours?\\b|\\b\\d+\\s*business\\s+days?)\\b",
      "flags": "i"
    },
    {
      "id": "reject_request_credentials",
      "action": "reject",
      "field": "response",
      "regex": "\\b((send|share|provide|tell|give)\\s+(me\\s+)?(your\\s+)?(password|passphrase|pin\\b|cvv|cvc|card\\s+number|credit\\s+card|full\\s+card)|what\\s+is\\s+your\\s+(password|pin\\b|cvv|card\\s+number)|I\\s+need\\s+your\\s+(password|pin\\b|cvv|card\\s+number))\\b",
      "flags": "i"
    },
    {
      "id": "replace_placeholders",
      "action": "replace_placeholders",
      "field": "both"
    },
    {
      "id": "reject_unresolved_placeholder",
      "action": "reject",
      "field": "both",
      "regex": "\\{\\{"
    }
  ],
  "placeholder_reject_name_regex": "(phone|e-?mail|\\burl\\b|hours?|hotline|website|toll-?free|social media|company\\s*name|companyname|\\bpolicy\\b|timeframe|opening time|closing time|business hours|working hours|support days|\\bchannel\\b|feature\\s*\\d|explanation of|platform\\s*\\d|city\\s*\\d|\\bclaims\\b|complaint |refund time|shipping time|delivery time|\\beta\\b|cut-?off|guarantee period|number of days|representative name|store location|store address|online store|retail stores|marketplace|\\bhandle\\b|live chat support|contact method|\\bdepartment\\b|ticket number|start time|end time|portal info|page url|helpline|hotline|login page url|support page|help center|claims website|free customer support number|customer support contact|company phone|company support|registration support phone|product reviews email|feedback email|payment issue (phone|email)|refund hotline|refund helpline)",
